DATABASE_URL="file:./dev.db"
PORT=3001

# 必須: HTTP Basic認証のID/PASSWORD。社内共有ツールとして、ブラウザ標準の
# ID/PASSWORDダイアログで認証する(独自ログイン画面は使わない)。
# PASSWORDはランダムな高エントロピー文字列を設定すること。例: openssl rand -hex 24
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# フロントエンドのオリジン(複数指定はカンマ区切り)
CORS_ORIGIN="http://localhost:5173"

# 任意設定 (詳細は src/index.ts のコメント参照)
# リバースプロキシ配下で動かす場合のみ設定する(X-Forwarded-For を信頼してクライアントの IP を求める)。
# レート制限・認証試行の回数制限はこの IP 単位で数える。直接公開する構成では設定しないこと(IP 偽装を許す)。
#   未設定 / false : 信頼しない(プロキシ配下では全員がプロキシの IP に見え、制限の枠を全員で共有する)
#   数値(例: 1)  : プロキシの段数。X-Forwarded-For の右からその段数ぶん遡った値を使う(推奨)。
#                   アプリへの接続が必ずそのプロキシを経由する構成でのみ使うこと
#   IP/CIDR       : カンマ区切り(例: 10.0.0.0/8,127.0.0.1)。その範囲からの接続だけをプロキシとして信頼する
#   true          : すべて信頼する(X-Forwarded-For の左端を使うため偽装で制限を回避され得る。非推奨)
#   true/false は大文字小文字を問わない。0 は信頼しない。解釈できない値は起動時に warn を出して
#   「信頼しない」として起動する。採用した解釈は起動時に「trustProxy: ...」の info ログで確認できる。
# Railway 等では、まず実際のログ(401 の行の ip / ips / xForwardedFor / remoteAddress)でプロキシの段数を
# 確認してから数値を設定すること。
# TRUST_PROXY=1
