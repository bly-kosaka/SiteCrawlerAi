DATABASE_URL="file:./dev.db"
PORT=3001

# 必須: APIキー(共有シークレット)。ランダムな高エントロピー文字列を設定すること。
# 例: openssl rand -hex 32
API_KEY=

# フロントエンドのオリジン(複数指定はカンマ区切り)
CORS_ORIGIN="http://localhost:5173"

# 任意設定 (詳細は src/index.ts のコメント参照)
# 本番(HTTPS)で動かす場合は production にする(Cookieのsecure属性が有効になる)
# NODE_ENV=production
# リバースプロキシ配下で動かす場合のみ true にする(X-Forwarded-Forを信頼する)
# TRUST_PROXY=true
