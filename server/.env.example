DATABASE_URL="file:./dev.db"
PORT=3001

# 必須: HTTP Basic認証のID/PASSWORD。社内共有ツールとして、ブラウザ標準の
# ID/PASSWORDダイアログで認証する(独自ログイン画面は使わない)。
# PASSWORDはランダムな高エントロピー文字列を設定すること。例: openssl rand -hex 24
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# フロントエンドのオリジン(複数指定はカンマ区切り)
CORS_ORIGIN="http://localhost:5173"

# 任意設定 (詳細は src/index.ts のコメント参照)
# リバースプロキシ配下で動かす場合のみ true にする(X-Forwarded-Forを信頼する)
# TRUST_PROXY=true
